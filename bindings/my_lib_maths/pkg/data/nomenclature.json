          "description": "Direct memory calls via exported WebAssembly functions."
        },
        "jssyscall": {
          "code": "S",
          "label": "jssyscall",
          "description": "Proprietary Go runtime syscall mapping targeting the JavaScript host environment."
        },
        "jsonrpc": {
          "code": "R",
          "label": "jsonrpc",
          "description": "Asynchronous inter-process communication using JSON-RPC over stdout/stdin."
        },
        "native": {
          "code": "N",
          "label": "native",
          "description": "Direct native execution entrypoint on the host language runner."
        }
      },
      "variant": {
