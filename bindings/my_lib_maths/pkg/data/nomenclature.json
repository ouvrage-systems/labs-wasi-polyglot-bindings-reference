        },
        "tasks": {
          "code": "T",
          "label": "tasks",
          "description": "TinyGo experimental internal scheduler (goroutines mapped to fibers)."
        },
        "native": {
          "code": "N",
          "label": "native",
          "description": "Uses the native scheduler of the host runtime or the standard Go compiler."
        }
      },
      "entrypoint": {
        "export": {
          "code": "E",
